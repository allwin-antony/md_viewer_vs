{
  "name": "md-viewer",
  "displayName": "Markdown Previewer Pro",
  "description": "Advanced Markdown viewer with LaTeX, Mermaid diagrams, syntax highlighting, and rich formatting support",
  "publisher": "allwin-antony",
  "version": "1.1.6",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allwin-antony/md_viewer_vs"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "mermaid",
    "latex",
    "katex",
    "viewer",
    "markdown-preview"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "configuration": {
      "title": "MD Previewer Configuration",
      "properties": {
        "mdViewer.chromePath": {
          "type": "string",
          "default": "",
          "description": "Custom absolute path to Google Chrome, Chromium, or Microsoft Edge executable for PDF exports. If empty, standard directories will be auto-searched."
        },
        "mdViewer.preview.fontFamily": {
          "type": "string",
          "default": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "description": "Customize the font family of the Markdown preview content."
        },
        "mdViewer.preview.fontSize": {
          "type": "string",
          "default": "14px",
          "description": "Customize the font size of the Markdown preview content (e.g., '14px', '1em', 'large')."
        },
        "mdViewer.preview.lineHeight": {
          "type": "string",
          "default": "1.7",
          "description": "Customize the line height of the Markdown preview content (e.g., '1.7', '150%')."
        },
        "mdViewer.preview.syncSelection": {
          "type": "boolean",
          "default": true,
          "description": "Enable bidirectional selection synchronization between the markdown editor and the preview."
        }
      }
    },
    "commands": [
      {
        "command": "mdViewer.toggleView",
        "title": "View Preview",
        "icon": "$(markdown)"
      },
      {
        "command": "mdViewer.viewPreview",
        "title": "View Preview",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdViewer.toggleView",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "mdViewer.toggleView",
          "when": "activeWebviewPanelId == 'mdViewer'",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mdViewer.viewPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "package:vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/markdown-it": "^13.0.0",
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.16.8",
    "markdown-it": "^14.1.1",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.15.0",
    "morphdom": "^2.7.8"
  }
}